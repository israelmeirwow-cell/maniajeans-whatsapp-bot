<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maniajeans.weekly-report</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/israelmeir/chatbot/logs/whatsapp_agent/deploy/run_weekly_report.sh</string>
  </array>

  <!-- Every Sunday at 09:00 (launchd: Weekday 0 = Sunday). If the Mac is asleep/off at 09:00,
       launchd runs it at the next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/israelmeir/chatbot/logs/whatsapp_agent/data/logs/weekly_report.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/israelmeir/chatbot/logs/whatsapp_agent/data/logs/weekly_report.launchd.log</string>
</dict>
</plist>
