# Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# WhatsApp gateway (Evolution API) — see deploy/evolution/ to run one locally
WA_GATEWAY_URL=http://localhost:8080
WA_GATEWAY_API_KEY=            # = AUTHENTICATION_API_KEY of the Evolution server
WA_INSTANCE_NAME=maniajeans
WA_WEBHOOK_SECRET=             # any random string; secures POST /webhook/{secret}

# Business rules
DELIVERY_SLA_DAYS=10

# App
STORE_NAME=DEMO Store
HANDOFF_NOTIFY=

# Embeddings (semantic lesson retrieval) — optional
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_MIN_SIM=0.30       # moderate-match floor (needs keyword/intent corroboration)
EMBEDDINGS_STRONG_SIM=0.42    # strong-match floor (accepted on semantics alone)
# VOYAGE_API_KEY=   # if set (+ pip install voyageai) -> used instead of the local model
# OPENAI_API_KEY=   # if set (+ pip install openai)   -> used instead of the local model
